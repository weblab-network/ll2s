 /****************************************************************************
  * [17.6] Priority vector calculation helper functions
  ****************************************************************************/
+
+/* Root selection compares candidate vectors in strict priority order.  The
+ * received-information replacement exception in compare_rstp_priority_vectors()
+ * must not let a worse path replace a better candidate from another local port
+ * merely because both advertise the same Designated Bridge and Designated Port.
+ */
+static enum vector_comparison
+compare_rstp_root_vectors(const struct rstp_priority_vector *v1,
+                          const struct rstp_priority_vector *v2)
+{
+    if (v1->root_bridge_id != v2->root_bridge_id) {
+        return v1->root_bridge_id < v2->root_bridge_id ? SUPERIOR : INFERIOR;
+    }
+    if (v1->root_path_cost != v2->root_path_cost) {
+        return v1->root_path_cost < v2->root_path_cost ? SUPERIOR : INFERIOR;
+    }
+    if (v1->designated_bridge_id != v2->designated_bridge_id) {
+        return v1->designated_bridge_id < v2->designated_bridge_id ? SUPERIOR : INFERIOR;
+    }
+    if (v1->designated_port_id != v2->designated_port_id) {
+        return v1->designated_port_id < v2->designated_port_id ? SUPERIOR : INFERIOR;
+    }
+    if (v1->bridge_port_id != v2->bridge_port_id) {
+        return v1->bridge_port_id < v2->bridge_port_id ? SUPERIOR : INFERIOR;
+    }
+    return SAME;
+}
 
